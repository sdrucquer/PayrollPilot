# Copy to .env in backend/ and bridge/ as noted. Never commit real values.

# --- Model access (backend) ---
OPENROUTER_API_KEY=
PP_MODEL=anthropic/claude-sonnet-5.5          # verified on openrouter.ai/api/v1/models 2026-10-20: tools + structured_outputs
PP_MODEL_CHEAP=anthropic/claude-haiku-5.5     # reply parsing / cheap classification
PP_MODEL_BUDGET_USD=5.00                      # hard stop; agent runs pause when exceeded

# --- Cognee (backend; docs.cognee.ai/setup-configuration/llm-providers) ---
LLM_PROVIDER=custom
LLM_MODEL=openrouter/anthropic/claude-haiku-5.5
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_API_KEY=                                  # same value as OPENROUTER_API_KEY
EMBEDDING_PROVIDER=fastembed                  # local, no key; BAAI/bge-small-en-v1.5, 384 dims
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# --- Messaging bridge (bridge/.env; Photon Spectrum writes these on scaffold) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
PP_BACKEND_URL=http://127.0.0.1:8000
PP_BRIDGE_TOKEN=change-me                     # shared secret between bridge and backend (both .env files)

# --- Test recipient allowlist (backend AND bridge; enforced in code in both) ---
PP_TEST_RECIPIENT=                            # owner's iMessage handle/phone, E.164. The ONLY allowed recipient.
PP_INTENDED_RESPONDENT_LABEL=Operations lead  # display label for the intended production respondent (de-identified)

# --- Browser Use (backend, lane A only) ---
BROWSER_USE_API_KEY=

# --- Band (product-agent handoff; CLI at ~/.local/bin/band) ---
PP_BAND_ENABLED=0                             # set 1 only after C-02 proves the CLI path
PP_BAND_ROOM=PayrollPilot Cases

# --- Pilot cycle (owner-confirmed against Gusto; O01) ---
PP_COMPANY_LABEL=Pilot Co                     # de-identified display name
PP_CYCLE_START=                               # YYYY-MM-DD, business timezone
PP_CYCLE_END=
PP_BUSINESS_TZ=America/New_York               # proposed default, confirm (policy registry)
