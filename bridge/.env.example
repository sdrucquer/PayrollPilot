# Photon Spectrum (dashboard -> project settings). The scaffold names PROJECT_ID/PROJECT_SECRET also work.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Only allowed recipient (E.164 or iMessage email). Same value as backend/.env.
PP_TEST_RECIPIENT=
# Shared secret with backend/.env
PP_BRIDGE_TOKEN=
PP_BACKEND_URL=http://127.0.0.1:8000
PP_BRIDGE_PORT=3001
# 1 = echo inbound text back (first-proof only)
PP_BRIDGE_ECHO=0
